<main>
    <div id="game-grid" class="grid-container">
        <div class="game-card" onclick="loadGame('https://cake-logic.itch.io/ultrakill-web-port', 'ULTRAKILL')">
            <img src="https://via.placeholder.com/150/ff0000/ffffff?text=ULTRAKILL" alt="Ultrakill">
            <h3>ULTRAKILL</h3>
        </div>
        
        <div class="game-card" onclick="loadGame('https://poki.com', 'Other Game')">
            <img src="https://via.placeholder.com/150/444/ffffff?text=GAME+2" alt="Game 2">
            <h3>More Games</h3>
        </div>
        </div>

    <div id="player-container" class="hidden">
        <button class="back-btn" onclick="showGrid()">← Back to Menu</button>
        <div class="game-container">
            <iframe id="game-frame" src="" frameborder="0" allowfullscreen></iframe>
        </div>
        <h2 id="current-title">Game Title</h2>
    </div>
</main>
